    <div class="search-row">
      <input id="nameInput" type="text" placeholder="Enter your name" autocomplete="off" />
      <button id="findBtn">Find</button>
    </div>
    <p id="statusMsg"></p>

    <div id="results"></div>

    <p class="hint">Search your first name, or first and last name together.</p>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js"></script>
<script>
  // ============================================================
  // PASTE YOUR PUBLISHED GOOGLE SHEET CSV LINK HERE
  // ============================================================
  const SHEET_URL = "https://docs.google.com/spreadsheets/d/1_ZvRtd3DyjuwzDIJmdGdNLIgW8kEH1siYH_srOFuXCU/edit?gid=0#gid=0";

function getCsvUrl(sheetUrl) {
  const match = sheetUrl.match(/\/spreadsheets\/d\/([a-zA-Z0-9-_]+)/);

  if (!match) {
    throw new Error('Invalid Google Sheet URL');
  }

  const spreadsheetId = match[1];

  return `https://docs.google.com/spreadsheets/d/${spreadsheetId}/export?format=csv`;
}


  // ============================================================

  let guestList = [];
  let dataLoaded = false;

  const nameInput = document.getElementById('nameInput');
  const findBtn = document.getElementById('findBtn');
  const statusMsg = document.getElementById('statusMsg');
  const resultsEl = document.getElementById('results');

  function setStatus(text, type) {
    statusMsg.textContent = text || '';
    statusMsg.className = type || '';
  }

  function normalize(str) {
    return (str || '').trim().toLowerCase().replace(/\s+/g, ' ');
  }

  async function loadGuestList() {
    setStatus('Loading the guest list…', 'loading');
    findBtn.disabled = true;
    try {
      const csvUrl = getCsvUrl(SHEET_URL);
      const response = await fetch(csvUrl, { cache: 'no-store' });
      if (!response.ok) throw new Error('Fetch failed');
      const csvText = await response.text();
      const parsed = Papa.parse(csvText.trim(), { skipEmptyLines: true });
      const rows = parsed.data;

      guestList = rows
        .slice(1) // skip header row
        .filter(row => row.length >= 3 && normalize(row[0]))
        .map(row => ({
          first: (row[0] || '').trim(),
          last: (row[1] || '').trim(),
          table: (row[2] || '').trim()
        }));

      dataLoaded = true;
      setStatus('', '');
    } catch (err) {
      setStatus("Couldn't load the guest list. Check your connection and refresh the page.", 'error');
    } finally {
      findBtn.disabled = false;
    }
  }

  function findGuests(query) {
    const q = normalize(query);
    if (!q) return [];
    const tokenCount = q.split(' ').length;

    if (tokenCount === 1) {
      // Match on first name only
      return guestList.filter(g => normalize(g.first) === q);
    } else {
      // Match on first + last name together
      return guestList.filter(g => normalize(g.first + ' ' + g.last) === q);
    }
  }

  function renderResults(matches) {
    resultsEl.innerHTML = '';
    if (matches.length === 0) return;

    matches.forEach(g => {
      const item = document.createElement('div');
      item.className = 'result-item';

      const displayName = g.last ? `${g.first} ${g.last}` : g.first;
      const showNamePrefix = matches.length > 1;

      item.innerHTML = `
        <p class="prefix">${showNamePrefix ? displayName + ' is seated at' : "You're seated at"}</p>
        <p class="table-line">Table ${g.table}</p>
      `;
      resultsEl.appendChild(item);
    });

    const celebrate = document.createElement('p');
    celebrate.className = 'celebrate';
    celebrate.textContent = "Can't wait to celebrate with you 🌸";
    resultsEl.appendChild(celebrate);
  }

  function handleSearch() {
    const query = nameInput.value;
    if (!dataLoaded) {
      setStatus('Still loading the guest list, one moment…', 'loading');
      return;
    }
    if (!normalize(query)) {
      setStatus('Enter a name first', 'error');
      resultsEl.innerHTML = '';
      return;
    }

    const matches = findGuests(query);
    if (matches.length === 0) {
      setStatus("Couldn't find that name. Try just your first name, or check the spelling.", 'error');
      resultsEl.innerHTML = '';
    } else {
      setStatus('', '');
      renderResults(matches);
    }
  }

  findBtn.addEventListener('click', handleSearch);
  nameInput.addEventListener('keydown', e => { if (e.key === 'Enter') handleSearch(); });

  loadGuestList();
</script>

</body>
